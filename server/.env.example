# MongoDB connection string. Transactions (task move) need a replica set
# (MongoDB Atlas is one by default). On a standalone local mongod the move
# endpoint now falls back to running WITHOUT a transaction instead of failing.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/flowspace

# Secret used to sign JWTs — use a long random string in production.
# The server refuses to start if this is missing.
JWT_SECRET=replace-with-a-long-random-string

# development | production
NODE_ENV=development

PORT=5000

# Extra allowed browser origins, comma-separated (exact match, no wildcards).
# e.g. your Vercel preview URL or custom domain.
CLIENT_URLS=
