# MongoDB connection string. Must be a replica-set-enabled cluster
# (MongoDB Atlas is by default) — the task-move endpoint uses transactions,
# which a bare standalone `mongod` does not support.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/flowspace

# Secret used to sign JWTs — use a long random string in production
JWT_SECRET=replace-with-a-long-random-string

# development | production
NODE_ENV=development

PORT=5000
